# LLM Provider Configuration
# Options: mock (offline echo, for dev/tests), litellm (routes to any provider litellm supports)
LLM_PROVIDER=litellm

# Default model when a request doesn't specify one, using litellm's "<provider>/<model>" convention.
# Examples: gemini/gemini-2.5-flash, openai/gpt-4o, anthropic/claude-sonnet-4-5-20250929
DEFAULT_MODEL=gemini/gemini-2.5-flash

# Optional allow-list restricting which "model" values a request may pass (JSON list).
# Empty = any model litellm supports is allowed.
ALLOWED_MODELS=[]

# Provider credentials — set only the ones for providers you use; litellm reads these
# directly from the environment. litellm supports 100+ providers; see
# https://docs.litellm.ai/docs/providers for the exact env var name per provider.
# Not needed for models routed through an external LiteLLM Proxy (see below) — the proxy
# holds these itself.
GEMINI_API_KEY=your_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: route some/all requests through an externally-hosted LiteLLM Proxy instead of
# --- calling providers directly. Both modes work side by side in the same deployment: any    
# --- model requested as "litellm_proxy/<alias>" (in DEFAULT_MODEL, ALLOWED_MODELS, or a
# --- request's own "model" field) goes through the proxy below; every other prefix
# --- (gemini/, openai/, anthropic/, ...) always calls that provider directly, regardless of
# --- whether these are set.
# LITELLM_PROXY_API_BASE=http://litellm-proxy.internal:4000
# LITELLM_PROXY_API_KEY=sk-...   # a virtual key issued by the proxy, not a real provider key
# DEFAULT_MODEL=litellm_proxy/gpt-4o   # <alias> is whatever the proxy's own config.yaml exposes

# NER Model Name
PL_NER_MODEL_NAME=radlab/pii-pl-v1.0

# API Keys (used for Authorization: Bearer <key> header), mapping each key to a client name
# for logging/identification. Example: API_KEYS={"sk-abc123": "internal-dashboard"}
API_KEYS={}


# Rate Limit
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
ALLOW_CREDENTIALS=False

# Debug mode
DEBUG=False

# Log file
LOG_FILE="./logs/app.log"
